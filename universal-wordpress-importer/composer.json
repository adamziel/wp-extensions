{
  "name": "wordpress/universal-importer",
  "description": "A resumable universal WordPress importer for trees of documents, archives, sites, and repositories.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.2.24",
    "wp-php-toolkit/data-liberation": "^0.1.5",
    "wp-php-toolkit/git": "^0.1.5"
  },
  "require-dev": {
    "php-stubs/wordpress-stubs": "^6.9",
    "phpstan/phpstan": "^1.12",
    "phpunit/phpunit": "^8.5 || ^9.6"
  },
  "autoload": {
    "classmap": [
      "vendor/wp-php-toolkit/filesystem",
      "vendor/wp-php-toolkit/http-client",
      "vendor/wp-php-toolkit/git"
    ],
    "exclude-from-classmap": [
      "vendor/wp-php-toolkit/*/Tests/"
    ],
    "psr-4": {
      "UniversalImporter\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "UniversalImporter\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "build:release": "php tools/build-release.php",
    "lint": "phpstan analyse --configuration=phpstan.neon.dist --memory-limit=1G --no-progress",
    "smoke:release": "php tools/smoke-release-activation.php --build",
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
