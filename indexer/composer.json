{
  "name": "local/wp-pure-php-fts",
  "description": "Pure-PHP HTML-aware full-text search engine for WordPress.",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "wp-php-toolkit/full-text-search": "^0.1"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../components/full-text-search",
      "options": {
        "symlink": false,
        "versions": {
          "wp-php-toolkit/full-text-search": "0.1.0"
        }
      }
    }
  ],
  "autoload": {
    "files": [
      "src/bootstrap.php"
    ]
  },
  "scripts": {
    "test": "php tests/run.php",
    "test:bm25-reference": "php tests/bm25-reference-gate.php --json",
    "test:snowball": "php tests/snowball-compliance.php",
    "test:provider-compatibility": "php tests/quality/provider-compatibility-certification-contracts.php",
    "test:integration:real": "php tests/integration/real-wordpress-mysql.php",
    "test:integration:mysql-proof": "php tests/integration/real-mysql-production-proof.php",
    "test:integration:concurrent": "php tests/integration/concurrent-indexing.php",
    "test:smoke:provider-compatibility": "php tools/smoke-search-provider-compatibility.php",
    "test:smoke:release": "php tools/smoke-disposable-wordpress-release.php",
    "test:smoke:release-provider:docker": "tools/run-disposable-release-provider-smoke.sh",
    "release:evidence": "php tools/collect-release-evidence.php"
  }
}
