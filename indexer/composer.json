{
  "name": "local/wp-pure-php-fts",
  "description": "Pure-PHP HTML-aware full-text search engine for WordPress.",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "wamania/php-stemmer": "^3.0"
  },
  "autoload": {
    "files": [
      "src/bootstrap.php"
    ]
  },
  "scripts": {
    "test": "php tests/run.php",
    "test:bm25-reference": "php tests/bm25-reference-gate.php --json",
    "test:snowball": "php tests/snowball-compliance.php",
    "test:integration:real": "php tests/integration/real-wordpress-mysql.php",
    "test:integration:concurrent": "php tests/integration/concurrent-indexing.php"
  }
}
