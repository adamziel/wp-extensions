{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Language FTS Preview",
    "description": "Installs and activates Language FTS, seeds multilingual demo posts, indexes them, and opens the Settings > Full-Text Search dashboard.",
    "author": "adamziel"
  },
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "landingPage": "/wp-admin/options-general.php?page=wp-fts-settings",
  "login": true,
  "siteOptions": {
    "blogname": "Language FTS Preview"
  },
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/adamziel/wp-extensions/main/indexer/playground/indexer-preview.zip"
      },
      "options": {
        "activate": true,
        "targetFolderName": "indexer"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-content/plugins/indexer/playground/dashboard-demo-content.php';"
    }
  ]
}
