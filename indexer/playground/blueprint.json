{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Language FTS Preview",
    "description": "Installs and activates Language FTS from the indexer/ directory and opens the Settings > Full-Text Search sandbox.",
    "author": "adamziel"
  },
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "landingPage": "/wp-admin/options-general.php?page=wp-fts-settings&tab=sandbox",
  "login": true,
  "siteOptions": {
    "blogname": "Language FTS Preview"
  },
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "git:directory",
        "url": "https://github.com/adamziel/wp-extensions",
        "path": "indexer",
        "ref": "main",
        "refType": "branch"
      },
      "options": {
        "activate": true,
        "targetFolderName": "indexer"
      }
    }
  ]
}
