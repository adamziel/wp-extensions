{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Pure PHP FTS Indexer SQLite Smoke",
    "description": "Installs the built Language FTS release artifact in WordPress Playground on SQLite and verifies multilingual index/search behavior.",
    "author": "adamziel"
  },
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "landingPage": "/wp-admin/plugins.php",
  "login": true,
  "extraLibraries": ["wp-cli"],
  "siteOptions": {
    "blogname": "Pure PHP FTS Indexer SQLite Smoke"
  },
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "bundled",
        "path": "wp-fts-indexer.zip"
      },
      "options": {
        "activate": true,
        "targetFolderName": "indexer"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php define('WP_FTS_PLAYGROUND_SMOKE_MODE', 'setup'); require '/wordpress/wp-content/plugins/indexer/playground/sqlite-smoke.php';"
    },
    {
      "step": "wp-cli",
      "command": "wp fts reindex --post_status=publish --post_type=post --lang=en --batch_size=10"
    },
    {
      "step": "wp-cli",
      "command": "wp fts search playgroundcliword --lang=en --limit=5 --post_status=publish --post_type=post --snippet"
    },
    {
      "step": "runPHP",
      "code": "<?php define('WP_FTS_PLAYGROUND_SMOKE_MODE', 'post-wpcli'); require '/wordpress/wp-content/plugins/indexer/playground/sqlite-smoke.php';"
    }
  ]
}
