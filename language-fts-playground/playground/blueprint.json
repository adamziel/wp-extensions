{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Language FTS Playground",
    "description": "Installs a SQLite-friendly PHP language FTS demo with seeded English, Polish, and German posts.",
    "author": "adamziel",
    "categories": ["search", "sqlite", "playground"]
  },
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "landingPage": "/wp-admin/tools.php?page=language-fts-playground",
  "login": true,
  "siteOptions": {
    "blogname": "Language FTS Playground"
  },
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "git:directory",
        "url": "https://github.com/adamziel/wp-extensions",
        "path": "language-fts-playground",
        "ref": "main",
        "refType": "branch"
      },
      "options": {
        "activate": true,
        "targetFolderName": "language-fts-playground"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php\nif (!defined('ABSPATH')) {\n    require '/wordpress/wp-load.php';\n}\n\nif (class_exists('Language_FTS_Playground_Demo') && class_exists('Language_FTS_Playground_Plugin')) {\n    Language_FTS_Playground_Demo::seed_posts();\n    Language_FTS_Playground_Plugin::rebuild_index();\n}\n"
    }
  ]
}
