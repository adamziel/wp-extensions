{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Universal WordPress Importer",
		"description": "Install Universal WordPress Importer with bundled sample data.",
		"author": "Adam Zielinski",
		"categories": ["data-liberation", "import", "tools"]
	},
	"landingPage": "/wp-admin/tools.php?page=universal-wordpress-importer",
	"login": true,
	"preferredVersions": {
		"wp": "latest",
		"php": "8.3"
	},
	"extraLibraries": ["wp-cli"],
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/adamziel/wp-extensions/5f12fb9acc21438492784c24c8a61481a13ee284/universal-wordpress-importer/dist/universal-wordpress-importer-0.1.0.zip?v=20260520-sparse-git-only"
			},
			"options": {
				"activate": true,
				"targetFolderName": "universal-wordpress-importer"
			}
		}
	]
}
