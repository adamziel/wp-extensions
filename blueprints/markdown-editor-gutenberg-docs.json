{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Markdown Editor: Gutenberg Docs",
		"description": "Load the Gutenberg documentation tree into the Markdown-backed WordPress editor.",
		"author": "Adam Zielinski",
		"categories": ["markdown", "editor", "documentation", "gutenberg"]
	},
	"landingPage": "/wp-admin/edit.php?post_type=page",
	"login": true,
	"preferredVersions": {
		"wp": "latest",
		"php": "8.4"
	},
	"features": {
		"networking": true
	},
	"steps": [
		{
			"step": "unzip",
			"zipFile": {
				"resource": "url",
				"url": "https://github.com/adamziel/wp-extensions/releases/download/markdown-editor-latest/wp-markdown-editor.zip"
			},
			"extractToPath": "/wordpress"
		},
		{
			"step": "writeFiles",
			"writeToPath": "/tmp/gutenberg-docs",
			"filesTree": {
				"resource": "git:directory",
				"url": "https://github.com/WordPress/gutenberg",
				"ref": "trunk",
				"path": "docs"
			}
		},
		{
			"step": "writeFile",
			"path": "/tmp/import-gutenberg-docs.php",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/adamziel/wp-extensions/main/blueprints/import-gutenberg-docs.php"
			}
		},
		{
			"step": "mkdir",
			"path": "/markdown-root"
		},
		{
			"step": "runPHP",
			"code": "<?php require '/tmp/import-gutenberg-docs.php';"
		},
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "Gutenberg Docs Markdown Editor",
				"permalink_structure": "/%postname%/"
			}
		},
		{
			"step": "mkdir",
			"path": "/wordpress/wp-content/mu-plugins"
		},
		{
			"step": "mv",
			"fromPath": "/wordpress/wp-markdown-editor/markdown-editor/vendor",
			"toPath": "/wordpress/wp-content/mu-plugins/vendor"
		},
		{
			"step": "mv",
			"fromPath": "/wordpress/wp-markdown-editor/markdown-editor/edit-markdown-mu-plugin.php",
			"toPath": "/wordpress/wp-content/mu-plugins/edit-markdown-mu-plugin.php"
		}
	]
}
